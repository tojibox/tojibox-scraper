# Tojibox Scraper — environment variables
# Copy this to .env and fill in your values. Never commit the real .env file.

# ── Database (Supabase Postgres, direct psycopg2/pg connection) ───────────────
# Supabase dashboard → Project Settings → Database → Connection info
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# ── County ──────────────────────────────────────────────────────────────────
COUNTY_ID=raleigh_nc

# ── ArcGIS source endpoints (defaults shown — only override if the source moves) ─
ARCGIS_PARCELS_URL=https://maps.wakegov.com/arcgis/rest/services/Property/Parcels/MapServer/0/query
ARCGIS_ZONING_URL=https://maps.raleighnc.gov/arcgis/rest/services/Planning/Zoning/MapServer/0/query

# ── Batch sizes ─────────────────────────────────────────────────────────────
ARCGIS_PAGE_SIZE=2000
SUPABASE_BATCH=100

# ── GIWA (OP-Stack EVM L2 testnet: GIWA Sepolia, chain ID 91342) ──────────────
GIWA_RPC_URL=https://sepolia-rpc.giwa.io/
GIWA_PRIVATE_KEY=0x...
# Deployer/oracle EOA that is allowed to call TojiboxOracle.commitBatch()
# (can be the same address derived from GIWA_PRIVATE_KEY for testnet)
ORACLE_ADDRESS=
# Filled in after `npx hardhat run scripts/deploy.js --network giwaSepolia`
TOJIBOX_ORACLE_ADDRESS=

# ── Pipeline (pipeline/processor.mjs) ─────────────────────────────────────────
BATCH_SIZE=100

# ── Oracle API ────────────────────────────────────────────────────────────────
API_PORT=8001

# ── Cron schedules (scrapers/scheduler.py — standard crontab syntax) ──────────
REZONING_CRON_SCHEDULE=0 */6 * * *
PARCEL_CRON_SCHEDULE=0 2 * * *
PETITION_CRON_SCHEDULE=0 */4 * * *

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
